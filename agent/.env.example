# Academia Shield Agent Environment Configuration (No Secrets)

# Backend API Endpoint URL
API_URL=http://127.0.0.1:8000

# Agent Polling & Timeout Settings
POLL_INTERVAL=8
REQUEST_TIMEOUT=10
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2.0

# DNS Resolver Settings
DNS_LISTEN_HOST=127.0.0.1
DNS_LISTEN_PORT=5353
DNS_UPSTREAM=8.8.8.8
DNS_UPSTREAM_PORT=53
DNS_TTL=300

# Process Monitoring Settings
PROCESS_SCAN_INTERVAL=3.0

# Data Directory (Default: ~/.academia_shield)
# AGENT_DATA_DIR=~/.academia_shield
