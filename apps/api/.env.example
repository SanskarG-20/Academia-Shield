MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/academia-shield
MONGO_URI_DIRECT=mongodb://<username>:<password>@cluster-shard-00-00.xxxxx.mongodb.net:27017,cluster-shard-00-01.xxxxx.mongodb.net:27017,cluster-shard-00-02.xxxxx.mongodb.net:27017/academia-shield?ssl=true&authSource=admin&replicaSet=<replicaSetName>&retryWrites=true&w=majority
MONGO_DB_NAME=academia-shield
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY_MS=2500
MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1
JWT_SECRET=your-super-secret-jwt-key
PORT=5000
CLIENT_URL=http://localhost:3000

# --- Email (used to deliver student OTPs when STUDENT_OTP_MODE=email) ---
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
TEST_MODE=true
AGENT_ALLOWED_DEVICE_IDS=

# --- Student OTP delivery ---
# email — real OTP mailed to the student (the default, and the only safe production value)
# mock  — fixed well-known code, for local demos only
STUDENT_OTP_MODE=email
MOCK_STUDENT_OTP=123456
# Escape hatch: allows STUDENT_OTP_MODE=mock even when NODE_ENV=production. Without
# this, a production server refuses to issue mock codes and returns 503 instead of
# silently accepting a hardcoded password. Leave unset unless you truly need it.
ALLOW_INSECURE_OTP=

# --- Professor self-registration ---
# Comma-separated email domains permitted to create a faculty account on first
# login. Empty disables self-registration entirely — accounts must then come from
# the seed script or a manual insert.
ALLOWED_PROFESSOR_DOMAINS=
