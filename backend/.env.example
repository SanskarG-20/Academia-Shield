# Academia Shield Production FastAPI Backend Environment Config

PROJECT_NAME=Academia Shield API
API_V1_STR=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=academia_shield

# Optional Explicit DATABASE_URL (Overrides individual POSTGRES_* params if set)
# DATABASE_URL=postgresql+psycopg2://your_postgres_user:your_postgres_password@localhost:5432/academia_shield
DATABASE_URL=sqlite:///./academia_shield_v2.db

# Security & JWT Tokens (DO NOT COMMITT PRODUCTION SECRETS)
JWT_SECRET=replace_this_with_a_secure_random_32_plus_char_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://academia-shield.vercel.app"]

# Server Settings
PORT=8000
HOST=0.0.0.0
SHOW_DOCS=true
