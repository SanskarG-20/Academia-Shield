# Academia Shield Agent — Development Configuration
# Use this for local testing with localhost API

TEST_MODE=true
API_URL=http://localhost:5000
POLL_INTERVAL=8
REQUEST_TIMEOUT=5
RETRY_ATTEMPTS=3
ENFORCEMENT_MODE=HOSTS
SOCKET_ENABLED=false

# Must match AGENT_SHARED_SECRET on the API. Empty omits the header, which the
# server accepts only while it is also running with the secret unset.
AGENT_SHARED_SECRET=
