# Academia Shield Agent — Development Configuration
# Use this for local testing with localhost API

TEST_MODE=true
API_URL=https://academia-shield.onrender.com
POLL_INTERVAL=8
REQUEST_TIMEOUT=5
RETRY_ATTEMPTS=3
ENFORCEMENT_MODE=HOSTS
SOCKET_ENABLED=false

# Must match AGENT_SHARED_SECRET on the API. Empty omits the header, which the
# server accepts only while it is also running with the secret unset.
AGENT_SHARED_SECRET=

# Web origins allowed to pair this machine via 127.0.0.1:49494.
PAIRING_ALLOWED_ORIGINS=https://academia-shield.vercel.app,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
