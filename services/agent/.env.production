# Academia Shield Agent — Production Configuration (Render)
# Use this for production deployment with Render API

TEST_MODE=false
API_URL=https://academia-shield-api.onrender.com
POLL_INTERVAL=30
REQUEST_TIMEOUT=10
RETRY_ATTEMPTS=5
ENFORCEMENT_MODE=HOSTS
SOCKET_ENABLED=false
STUDENT_SAP_ID=

# Must match AGENT_SHARED_SECRET on the API. Set both together: the server only
# starts rejecting unauthenticated /api/agent/* calls once its own value is set,
# so roll the rebuilt .exe out first, then set it on Render.
AGENT_SHARED_SECRET=
